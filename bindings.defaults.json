{
  "_comment": "Strict JSON: _comment keys are documentation. Physical south/east/west/north identify button positions, independent of printed letters. All raw presets must be checked with --inspect.",
  "token": "",
  "preset": "8bitdo_switch",
  "device_name_contains": "",
  "poll_hz": 120,
  "debug": false,
  "bridge": {
    "_comment": "socket = primary TCP mode; hotkey = pynput key injection. Loopback only. TTL discards old actions, ACK confirms API dispatch rather than game/server success.",
    "mode": "socket",
    "host": "127.0.0.1",
    "port": 47651,
    "queue_limit": 32,
    "action_ttl_ms": 600,
    "ack_timeout_ms": 2500,
    "state_interval_ms": 50
  },
  "focus": {
    "_comment": "Game input requires the selected foreground title AND executable plus the connected listener process ID. Cursor can operate globally when enabled.",
    "require_focus": true,
    "window_title_contains": [],
    "process_names": [
      "ClassicUO.exe"
    ],
    "exclude_titles_containing": [
      "Razor"
    ]
  },
  "input": {
    "_comment": "Stick deadzones are radial/rescaled. Move/run thresholds apply after rescaling. Triggers use press/release hysteresis then debounce. repeat_ms=0 means one event per press; >=50 enables continuous repeat. Trigger strength is sent in value for custom listener extensions.",
    "left_deadzone": 0.18,
    "right_deadzone": 0.2,
    "move_threshold": 0.28,
    "run_threshold": 0.82,
    "debounce_ms": 20,
    "trigger_press": 0.62,
    "trigger_release": 0.42,
    "run_control": "",
    "scroll_control": "rb",
    "movement_stick": "left",
    "mouse_stick": "right"
  },
  "modifier_controls": [],
  "razor": {
    "_comment": "RE API calls stay on one script thread. Target waits poll, never WaitForTarget. Actual movement API can wait for server acknowledgement. Intervals are extra delay after API return; tune to shard latency.",
    "loop_pause_ms": 10,
    "movement_timeout_ms": 250,
    "reconnect_ms": 1000,
    "walk_interval_ms": 200,
    "run_interval_ms": 100,
    "blocked_retry_ms": 350,
    "show_gump": false
  },
