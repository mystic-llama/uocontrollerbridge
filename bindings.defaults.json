  "desktop": {
    "_comment": "Right stick moves OS cursor. Hold RB/R1 for vertical wheel scroll. Hotkey names follow pynput.keyboard.Key (ctrl, alt, shift, f1, etc.). Configure matching Razor hotkeys manually. Movement uses classic UO numpad direction keys by default. Action chords F1..F12 then Shift+F1..F7 are unique defaults. Printed below in README. OS/RE must register them; injection cannot create Razor bindings.",
    "cursor_pixels_per_second": 650,
    "cursor_curve": 1.6,
    "scroll_per_second": 10,
    "hotkey_tap_ms": 60,
    "run_hotkey": [
      "ctrl"
    ],
    "movement_hotkeys": {
      "North": [
        "numpad9"
      ],
      "Right": [
        "numpad6"
      ],
      "East": [
        "numpad3"
      ],
      "Down": [
        "numpad2"
      ],
      "South": [
        "numpad1"
      ],
      "Left": [
        "numpad4"
      ],
      "West": [
        "numpad7"
      ],
      "Up": [
        "numpad8"
      ]
    },
    "hotkeys": {
      "cast_heal": [
        "f1"
      ],
      "cast_cure": [
        "f2"
      ],
      "cast_greater_heal": [
        "f3"
      ],
      "cast_energy_bolt": [
        "f4"
      ],
      "cast_invisibility": [
        "f5"
      ],
      "bandage_self": [
        "f6"
      ],
      "drink_heal": [
        "f7"
      ],
      "drink_cure": [
        "f8"
      ],
      "drink_refresh": [
        "f9"
      ],
      "drink_agility": [
        "f10"
      ],
      "target_self": [
        "f11"
      ],
      "target_last": [
        "f12"
      ],
      "cancel_target": [
        "shift",
        "f1"
      ],
      "attack_last": [
        "shift",
        "f2"
      ],
      "cycle_target": [
        "shift",
        "f3"
      ],
      "switch_weapon": [
        "shift",
        "f4"
      ],
      "primary_ability": [
        "shift",
        "f5"
      ],
      "secondary_ability": [
        "shift",
        "f6"
      ],
      "meditate": [
        "shift",
        "f7"
      ]
    },
    "global_cursor": true,
    "cursor_backend": "windows_desktop"
  },
  "controller_ui_version": 2
